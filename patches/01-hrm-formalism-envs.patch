+def _neutralize_reject_state(automaton):
+    """Drop the rejecting state and every edge into it, leaving the rest intact.
+
+    A transition with no matching edge leaves the hierarchy state unchanged, so
+    the hazard label becomes a self-loop rather than a terminal.
+    """
+    reject = automaton.get_reject_state() if automaton.has_reject_state() else None
+    if reject is None:
+        return
+    for from_state in list(automaton._edges.keys()):
+        automaton._edges[from_state].pop(reject, None)
+    automaton._edges.pop(reject, None)
+    if reject in automaton._states:
+        automaton._states.remove(reject)
+    automaton._reject_state = None
+
